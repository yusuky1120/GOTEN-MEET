# Empty keeps local development on Vite's /api proxy (localhost:8787).
# Cloudflare Pages MUST set this to the deployed Worker origin (no trailing slash),
# otherwise the SPA POSTs /api/livekit/* to Pages itself and gets HTTP 405.
# Example: VITE_TOKEN_API_BASE_URL=https://goten-meet-token-api.yusuky1120.workers.dev
VITE_TOKEN_API_BASE_URL=

# Cloudflare Pages (goten-meet.pages.dev): /
# GitHub Pages project site: /GOTEN-MEET/
VITE_BASE_PATH=/
